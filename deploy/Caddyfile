{$EVALFORGE_DOMAIN:localhost} {
	encode gzip
	handle /api/v1/auth/login {
		rate_limit {
			zone login {
				key {client_ip}
				events 20
				window 1m
			}
		}
		reverse_proxy api:8000
	}
	handle /api/v1/evaluations {
		rate_limit {
			zone evaluations {
				key {client_ip}
				events 30
				window 1m
			}
		}
		reverse_proxy api:8000
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy frontend:80
	}
}
